
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title> Mesversario</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: 'Segoe UI', sans-serif;
    background: linear-gradient(#fdf6e3, #f8e7c9);
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    overflow: hidden;
}

.fondo {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
}

.girasol {
    position: absolute;
    top: -100px;
    animation: caer linear infinite;
    pointer-events: none;
}

@keyframes caer {
    0% {
        transform: translateY(-100px) rotate(0deg);
    }
    100% {
        transform: translateY(110vh) rotate(360deg);
    }
}

.container {
    width: min(500px, calc(100vw - 30px));
    height: min(680px, 88vh);
    background: #ffffff;
    border-radius: 25px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.15);
    position: relative;
    z-index: 2;
    overflow: visible;
}

.decor-flor {
    position: absolute;
    width: 180px;
    max-width: 40%;
    z-index: 5;
    pointer-events: none;
}

.flor1 {
    top: -60px;
    left: -60px;
}

.flor2 {
    bottom: -60px;
    right: -60px;
    transform: rotate(180deg);
}

.slide {
    position: absolute;
    inset: 0;
    display: none;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    padding: 25px;
}

.slide.active {
    display: flex;
}

h1 {
    color: #6b8e23;
    font-size: 42px;
    text-align: center;
}

.slide p {
    text-align: center;
    color: #5c7a2c;
    font-size: 18px;
}

.slide img {
    width: 100%;
    max-width: 460px;
    max-height: 55%;
    object-fit: contain;
    margin-top: 10px;
}

.botones {
    position: absolute;
    bottom: 15px;
    width: 100%;
    display: flex;
    justify-content: center;
    gap: 10px;
    left: 0;
    padding: 0 10px;
}

.botones button {
    background: #8fbf5a;
    color: white;
    border: none;
    padding: 10px 18px;
    border-radius: 25px;
    font-size: 14px;
    cursor: pointer;
    animation: pulse 2s infinite;
}

.botones button:hover {
    background: #6b963e;
}

@keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.08); }
}

.carta-slide {
    justify-content: center;
    align-items: center;
}

.hoja-carta {
    width: 85%;
    max-width: 380px;
    height: 85%;
    background: #fffef8;
    padding: 30px 25px;
    border-radius: 10px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    overflow-y: auto;
    font-size: 16px;
    line-height: 1.8;
    color: #222;
    text-align: justify;
}

.fecha {
    text-align: right;
    margin-bottom: 20px;
}

.destinatario {
    margin-bottom: 15px;
    text-align: left;
}

.hoja-carta p {
    margin-bottom: 16px;
}

.despedida {
    margin-top: 20px;
}

.firma {
    margin-top: 5px;
}

@media (max-width: 480px) {
    .container {
        height: 82vh;
    }

    h1 {
        font-size: 32px;
    }

    .slide p {
        font-size: 16px;
    }

    .hoja-carta {
        width: 90%;
        padding: 20px 17px;
        font-size: 14px;
        line-height: 1.6;
    }

    .decor-flor {
        width: 130px;
    }

    .flor1 {
        top: -40px;
        left: -35px;
    }

    .flor2 {
        bottom: -40px;
        right: -35px;
    }
}
</style>
</head>

<body>

<div class="fondo" id="fondo"></div>

<div class="container">

    <img class="decor-flor flor1"
    src="https://png.pngtree.com/png-clipart/20240310/original/pngtree-yellow-flowers-watercolor-png-image_14559868.png"
    alt="Flores amarillas">

    <img class="decor-flor flor2"
    src="https://png.pngtree.com/png-clipart/20240310/original/pngtree-yellow-flowers-watercolor-png-image_14559868.png"
    alt="Flores amarillas">

    <!-- DIAPOSITIVA 1 -->
    <div class="slide active">

        <h1>Para Fer 🐹</h1>

        <p>Un pequeño detalle para ti...</p>

        <img
        src="https://i.pinimg.com/736x/09/d6/59/09d6591427c8e14397b06ecab9017de4.jpg"
        alt="Flores amarillas">

        <div class="botones">
            <button onclick="nextSlide()">Siguiente ➜</button>
        </div>

    </div>

    <!-- DIAPOSITIVA 2 -->
    <div class="slide">

        <p>
            Aunque la distancia exista,<br>
            Mis ganas de amarte permanecen 
        </p>

        <img
        src="https://i.pinimg.com/736x/5e/82/4a/5e824a82825af4e0e878f4960517e3b5.jpg"
        alt="Flores amarillas">

        <div class="botones">
            <button onclick="prevSlide()">←</button>
            <button onclick="nextSlide()">→</button>
        </div>

    </div>

    <!-- DIAPOSITIVA 3 -->
    <div class="slide">

        <p>
            Cada detalle escrito es a manera en la que me he sentido a tu lado
        </p>

        <img
        src="https://i.pinimg.com/736x/15/f2/a0/15f2a03b543087186214be7d716c3620.jpg"
        alt="Flores">

        <div class="botones">
            <button onclick="prevSlide()">←</button>
            <button onclick="nextSlide()">→</button>
        </div>

    </div>

    <!-- DIAPOSITIVA 4 -->
    <div class="slide">

        <p>
            Tengo una sorpresa más para ti ✨
        </p>

        <img
        src="https://i.pinimg.com/736x/43/e7/98/43e798ebc28fa84a245c0997434303d0.jpg"
        alt="Sorpresa">

        <div class="botones">
            <button onclick="prevSlide()">←</button>
            <button onclick="goTo(4)">Abrir carta 💌</button>
        </div>

    </div>

    <!-- DIAPOSITIVA 5: CARTA -->
    <div class="slide carta-slide">

        <div class="hoja-carta">

            <div class="fecha">
                07 de Noviembre
            </div>

            <p class="destinatario">
                <strong>Amada mia,</strong>
            </p>

            <p>
                Los momentos más bonitos no siempre son los más grandes.
                A veces son las risas inesperadas, las conversaciones
                largas que parecen no tener fin, los pequeños detalles
                que casi nadie nota o simplemente el hecho de compartir
                tiempo juntos sin necesidad de hacer nada especial.
            </p>

            <p>
                Me he dado cuenta de que son precisamente esos instantes
                sencillos los que más se quedan en el corazón, los que
                uno recuerda incluso cuando todo cambia. Porque no se
                trata de lo que se hace, sino de con quién se vive.
            </p>

            <p>
                Cada recuerdo contigo se guarda como algo especial,
                como si tuviera un brillo distinto. Y sinceramente,
                espero que todavía nos queden muchísimos momentos más
                por vivir, más historias que contar y más recuerdos
                que atesorar con el tiempo.
            </p>

            <p>
                Porque al final, lo más valioso siempre será eso:
                los momentos compartidos, las emociones sinceras y
                todo aquello que, sin darnos cuenta, va construyendo
                algo bonito entre nosotros.
            </p>

            <p class="despedida">
                Con cariño,
            </p>

            <p class="firma">
                <strong>Jess 💛</strong>
            </p>

        </div>

        <div class="botones">
            <button onclick="goTo(0)">🏠 Inicio</button>
            <button onclick="prevSlide()">←</button>
        </div>

    </div>

</div>

<script>

// CONTROL DE DIAPOSITIVAS

let current = 0;

const slides = document.querySelectorAll(".slide");

function showSlide(index) {

    slides[current].classList.remove("active");

    current = index;

    slides[current].classList.add("active");

}

function nextSlide() {

    let next = current + 1;

    if (next >= slides.length) {
        next = 0;
    }

    showSlide(next);

}

function prevSlide() {

    let prev = current - 1;

    if (prev < 0) {
        prev = slides.length - 1;
    }

    showSlide(prev);

}

function goTo(index) {
    showSlide(index);
}


// ANIMACIÓN DE FLORES CAYENDO

const fondo = document.getElementById("fondo");

const imagenGirasol =
"https://www.pngmart.com/files/4/Sunflower-PNG-HD.png";

for (let i = 0; i < 25; i++) {

    let flor = document.createElement("img");

    flor.src = imagenGirasol;

    flor.className = "girasol";

    flor.style.left = Math.random() * 100 + "vw";

    flor.style.animationDuration =
        (5 + Math.random() * 5) + "s";

    flor.style.animationDelay =
        (-Math.random() * 10) + "s";

    flor.style.width =
        (25 + Math.random() * 35) + "px";

    fondo.appendChild(flor);

}

</script>

</body>
</html>
